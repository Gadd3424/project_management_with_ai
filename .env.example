APP_ENV=development
APP_NAME=Evolutionary Project AI
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/project_ai
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
JWT_SECRET=change-me-to-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
INFERENCE_URL=http://inference:8001
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=project-ai
MLFLOW_TRACKING_URI=http://mlflow:5000
AI_PROVIDER=mock
AI_MIN_EVIDENCE_COUNT=1
NEXT_PUBLIC_API_URL=/api/v1
API_INTERNAL_URL=http://api:8000/api/v1

